
.job-card.data-v-0b59c612 {
  background: linear-gradient(135deg, #ffffff, #f8faff);
  margin: 0;
  padding: 16px;
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(79, 172, 254, 0.15);
  position: relative;
  transition: all 0.3s ease;
  overflow: hidden;
}
.job-card.data-v-0b59c612::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(79, 172, 254, 0.05), rgba(0, 242, 254, 0.05));
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.job-card.data-v-0b59c612:hover::after {
  opacity: 1;
}
.job-card.data-v-0b59c612:active {
  transform: scale(0.98);
  box-shadow: 0 6px 20px rgba(79, 172, 254, 0.25);
}
.right-buttons.data-v-0b59c612 {
  position: absolute;
  top: 50%;
  right: 16px;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 10;
}
.favorite-btn.data-v-0b59c612 {
  background: linear-gradient(135deg, #ffffff, #f8faff);
  padding: 8px;
  border-radius: 50%;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.favorite-btn.data-v-0b59c612:active {
  transform: scale(0.9);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
}
.card-header.data-v-0b59c612 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-right: 80px;
}
.job-title.data-v-0b59c612 {
  font-size: 17px;
  font-weight: 600;
  color: #1E1E1E;
  flex: 1;
  background: linear-gradient(90deg, #1E1E1E, #4a4a4a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.salary.data-v-0b59c612 {
  font-size: 16px;
  font-weight: 500;
  background: linear-gradient(120deg, #4facfe, #00f2fe);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.company-info.data-v-0b59c612 {
  margin-bottom: 12px;
  padding-right: 80px;
}
.company-name.data-v-0b59c612 {
  font-size: 15px;
  font-weight: 500;
  color: #1E1E1E;
  margin-bottom: 8px;
  display: block;
}
.job-tags.data-v-0b59c612 {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8px;
  gap: 6px;
  padding-right: 80px;
}
.tag.data-v-0b59c612 {
  font-size: 12px;
  color: #6C757D;
  background: linear-gradient(135deg, #E6F0FF, #F0F4FF);
  padding: 4px 8px;
  border-radius: 8px;
  margin-right: 6px;
  margin-bottom: 6px;
  transition: all 0.3s ease;
}
.tag.data-v-0b59c612:active {
  transform: scale(0.95);
  background: linear-gradient(120deg, #4facfe, #00f2fe);
  color: white;
}
.card-footer.data-v-0b59c612 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid #E6F0FF;
  margin-top: 8px;
  padding-right: 80px;
}
.location.data-v-0b59c612 {
  display: flex;
  align-items: center;
  font-size: 13px;
  color: #1E1E1E;
}
.location.data-v-0b59c612::before {
  content: "📍";
  margin-right: 4px;
  color: #007aff;
}
.time.data-v-0b59c612 {
  font-size: 13px;
  color: #6C757D;
}

/* 投递按钮 */
.apply-btn.data-v-0b59c612 {
  background: linear-gradient(120deg, #4facfe, #00f2fe);
  color: white;
  font-size: 12px;
  font-weight: bold;
  padding: 6px 16px;
  border-radius: 20px;
  height: 32px;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(79, 172, 254, 0.3);
}
.apply-btn.applied.data-v-0b59c612 {
  background: linear-gradient(135deg, #E6F0FF, #F0F4FF);
  color: #6C757D;
  box-shadow: none;
}
.apply-btn.data-v-0b59c612:active {
  transform: scale(0.95);
  box-shadow: 0 1px 4px rgba(79, 172, 254, 0.4);
}
.apply-btn.applied.data-v-0b59c612:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #D6E8FF, #E6F0FF);
}
