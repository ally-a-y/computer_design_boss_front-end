<view class="change-password-page"><view class="nav-bar"><text class="back-btn" bindtap="{{a}}">←</text><text class="title">密码设置</text></view><view class="change-content"><view class="form-item"><text class="label">当前手机号</text><text class="current-phone">{{b}}</text></view><view class="form-item"><text class="label">验证码</text><view class="code-input"><input type="number" placeholder="请输入验证码" value="{{c}}" bindinput="{{d}}"/><button class="send-code-btn" bindtap="{{f}}" disabled="{{g}}">{{e}}</button></view></view><view class="form-item"><text class="label">新密码</text><input type="password" placeholder="请输入新密码" value="{{h}}" bindinput="{{i}}"/></view><view class="form-item"><text class="label">确认密码</text><input type="password" placeholder="请再次输入新密码" value="{{j}}" bindinput="{{k}}"/></view><button class="confirm-btn" bindtap="{{l}}">确认修改</button></view></view>