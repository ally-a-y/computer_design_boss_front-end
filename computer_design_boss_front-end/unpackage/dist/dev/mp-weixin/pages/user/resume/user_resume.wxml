view></view><view class="form-item"><text class="label">公司规模偏好</text><picker class="input" bindchange="{{ah}}" value="{{ai}}" range="{{aj}}"><view>{{ag}}</view></picker></view><view class="form-item"><text class="label">工作类型偏好</text><picker class="input" bindchange="{{al}}" value="{{am}}" range="{{an}}"><view>{{ak}}</view></picker></view></view><view class="section"><text class="section-title">校园经历</text><view class="campus-group"><view class="campus-item" bindtap="{{aq}}"><text class="campus-label">学生会经历</text><switch checked="{{ao}}" bindchange="{{ap}}" color="#007aff" style="transform:scale(0.8)"/></view><view class="campus-item" bindtap="{{at}}"><text class="campus-label">社团经历</text><switch checked="{{ar}}" bindchange="{{as}}" color="#007aff" style="transform:scale(0.8)"/></view><view class="campus-item" bindtap="{{ax}}"><text class="campus-label">奖学金</text><switch checked="{{av}}" bindchange="{{aw}}" color="#007aff" style="transform:scale(0.8)"/></view><view class="campus-item" bindtap="{{aA}}"><text class="campus-label">荣誉</text><switch checked="{{ay}}" bindchange="{{az}}" color="#007aff" style="transform:scale(0.8)"/></view></view><view class="form-item"><text class="label">详细描述</text><block wx:if="{{r0}}"><textarea class="textarea" placeholder="请输入详细描述" value="{{aB}}" bindinput="{{aC}}"/></block></view></view><view class="section"><view class="section-header"><text class="section-title">证书管理</text><text class="add-btn" bindtap="{{aD}}">+ 添加证书</text></view><view wx:for="{{aE}}" wx:for-item="certificate" wx:key="x" class="certificate-item"><view class="form-item"><text class="label">证书类型</text><picker class="input" bindchange="{{certificate.b}}" value="{{certificate.c}}" range="{{aF}}"><view>{{certificate.a}}</view></picker></view><view class="form-item"><text class="label">证书名称</text><input class="input" placeholder="请输入证书名称" value="{{certificate.d}}" bindinput="{{certificate.e}}"/></view><view class="form-item"><text class="label">等级/分数</text><input class="input" placeholder="请输入证书级别或分数" value="{{certificate.f}}" bindinput="{{certificate.g}}"/></view><view class="form-item"><text class="label">颁发日期</text><picker class="input" mode="date" bindchange="{{certificate.i}}" value="{{certificate.j}}"><view>{{certificate.h}}</view></picker></view><view class="form-item"><text class="label">有效期</text><picker class="input" mode="date" bindchange="{{certificate.l}}" value="{{certificate.m}}"><view>{{certificate.k}}</view></picker></view><view class="form-item"><text class="label">发证机构</text><input class="input" placeholder="请输入发证机构" value="{{certificate.n}}" bindinput="{{certificate.o}}"/></view><view class="form-item"><text class="label">证书编号</text><input class="input" placeholder="请输入证书编号" value="{{certificate.p}}" bindinput="{{certificate.q}}"/></view><view class="form-item"><text class="label">证书附件</text><view class="file-upload"><text class="upload-btn" bindtap="{{certificate.r}}">上传PDF证书</text><text wx:if="{{certificate.s}}" class="file-name">{{certificate.t}}</text></view></view><view class="certificate-actions"><text class="action-btn edit" bindtap="{{certificate.v}}">编辑</text><text class="action-btn delete" bindtap="{{certificate.w}}">删除</text></view></view></view></scroll-view></view>