<view class="resume-page"><view class="nav-bar"><text class="back-btn" bindtap="{{a}}">←</text><text class="title">我的简历</text><text class="save-btn" bindtap="{{b}}">保存</text></view><scroll-view scroll-y class="resume-content"><view class="section"><text class="section-title">基本信息</text><view class="form-item"><text class="label">姓名</text><input class="input" placeholder="请输入姓名" value="{{c}}" bindinput="{{d}}"/></view><view class="form-item"><text class="label">性别</text><picker class="input" bindchange="{{f}}" value="{{g}}" range="{{h}}"><view>{{e}}</view></picker></view><view class="form-item"><text class="label">出生日期</text><picker class="input" mode="date" bindchange="{{j}}" value="{{k}}"><view>{{i}}</view></picker></view><view class="form-item"><text class="label">电话</text><input class="input" placeholder="请输入手机号" type="number" value="{{l}}" bindinput="{{m}}"/></view><view class="form-item"><text class="label">邮箱</text><input class="input" placeholder="请输入邮箱" type="email" value="{{n}}" bindinput="{{o}}"/></view><view class="form-item"><text class="label">微信</text><input class="input" placeholder="请输入微信号" value="{{p}}" bindinput="{{q}}"/></view><view class="form-item"><text class="label">城市</text><input class="input" placeholder="请输入所在城市" value="{{r}}" bindinput="{{s}}"/></view><view class="form-item"><text class="label">教育水平</text><input class="input" placeholder="请输入教育水平" value="{{t}}" bindinput="{{v}}"/></view><view class="form-item"><text class="label">学校</text><input class="input" placeholder="请输入学校名称" value="{{w}}" bindinput="{{x}}"/></view><view class="form-item"><text class="label">专业</text><input class="input" placeholder="请输入专业" value="{{y}}" bindinput="{{z}}"/></view><view class="form-item"><text class="label">毕业年份</text><picker class="input" mode="date" fields="year" bindchange="{{B}}" value="{{C}}"><view>{{A}}</view></picker></view><view class="form-item"><text class="label">GPA</text><input class="input" placeholder="请输入GPA" type="number" step="0.01" 