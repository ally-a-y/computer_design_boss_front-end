="preference-item" bindtap="{{ah}}"><text class="preference-label">接受出差</text><switch checked="{{af}}" bindchange="{{ag}}" color="#007aff" style="transform:scale(0.8)"/></view></view><view class="form-item"><text class="label">公司规模偏好</text><picker class="input" bindchange="{{aj}}" value="{{ak}}" range="{{al}}"><view>{{ai}}</view></picker></view><view class="form-item"><text class="label">工作类型偏好</text><picker class="input" bindchange="{{an}}" value="{{ao}}" range="{{ap}}"><view>{{am}}</view></picker></view></view><view class="section"><text class="section-title">校园经历</text><view class="campus-group"><view class="campus-item" bindtap="{{as}}"><text class="campus-label">学生会经历</text><switch checked="{{aq}}" bindchange="{{ar}}" color="#007aff" style="transform:scale(0.8)"/></view><view wx:if="{{at}}" class="campus-desc-box"><block wx:if="{{r0}}"><textarea class="campus-textarea" placeholder="请描述学生会经历（职务、工作内容、成果等）" value="{{av}}" bindinput="{{aw}}"/></block></view></view><view class="campus-group"><view class="campus-item" bindtap="{{az}}"><text class="campus-label">社团经历</text><switch checked="{{ax}}" bindchange="{{ay}}" color="#007aff" style="transform:scale(0.8)"/></view><view wx:if="{{aA}}" class="campus-desc-box"><block wx:if="{{r0}}"><textarea class="campus-textarea" placeholder="请描述社团经历（社团名称、职务、活动等）" value="{{aB}}" bindinput="{{aC}}"/></block></view></view><view class="campus-group"><view class="campus-item" bindtap="{{aF}}"><text class="campus-label">奖学金</text><switch checked="{{aD}}" bindchange="{{aE}}" color="#007aff" style="transform:scale(0.8)"/></view><view wx:if="{{aG}}" class="campus-desc-box"><block wx:if="{{r0}}"><textarea class="campus-textarea" placeholder="请描述奖学金情况（奖项名称、等级、时间等）" value="{{aH}}" bindinput="{{aI}}"/></block></view></view><view class="campus-group"><view class="campus-item" bindtap="{{aL}}"><text class="campus-label">荣誉</text><switch checked="{{aJ}}" bindchange="{{aK}}" color="#007aff" style="transform:scale(0.8)"/></view><view wx:if="{{aM}}" class="campus-desc-box"><block wx:if="{{r0}}"><textarea class="campus-textarea" placeholder="请描述获得荣誉（奖项名称、颁发机构、时间等）" value="{{aN}}" bindinput="{{aO}}"/></block></view></view></view><view class="section"><view class="section-header"><text class="section-title">证书管理</text><text class="add-btn" bindtap="{{aP}}">+ 添加证书</text></view><view wx:for="{{aQ}}" wx:for-item="certificate" wx:key="r" class="certificate-item"><view class="form-item"><text class="label">证书类型</text><picker class="input" bindchange="{{certificate.b}}" value="{{certificate.c}}" range="{{aR}}"><view>{{certificate.a}}</view></picker></view><view class="form-item"><text class="label">证书名称</text><input class="input" placeholder="请输入证书名称" value="{{certificate.d}}" bindinput="{{certificate.e}}"/></view><view class="form-item"><text class="label">等级/分数</text><input class="input" placeholder="请输入证书级别或分数" value="{{certificate.f}}" bindinput="{{certificate.g}}"/></view><view class="form-item"><text class="label">颁发日期</text><picker class="input" mode="date" bindchange="{{certificate.i}}" value="{{certificate.j}}"><view>{{certificate.h}}</view></picker></view><view class="form-item"><text class="label">有效期</text><picker class="input" mode="date" bindchange="{{certificate.l}}" value="{{certificate.m}}"><view>{{certificate.k}}</view></picker></view><view class="form-item"><text class="label">发证机构</text><input class="input" placeholder="请输入发证机构" value="{{certificate.n}}" bindinput="{{certificate.o}}"/></view><view class="form-item"><text class="label">证书编号</text><input class="input" placeholder="请输入证书编号" value="{{certificate.p}}" bindinput="{{certificate.q}}"/></view></view></view></scroll-view></view>