
/* 全局样式 */
.register-page.data-v-1776d0fe {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F8FAFD;
  font-family: -apple-system, Helvetica, Roboto, sans-serif;
}
.register-container.data-v-1776d0fe {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 16px;
}

/* 导航栏样式 */
.nav-bar.data-v-1776d0fe {
  background-color: #ffffff;
  box-shadow: 0 1px 2px rgba(0,0,0,0.02);
  height: 56px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  position: relative;
  margin-bottom: 12px;
}
.nav-bar-left.data-v-1776d0fe {
  flex: 0 0 auto;
  padding: 8px;
}
.nav-bar-center.data-v-1776d0fe {
  flex: 1;
  text-align: center;
}
.nav-bar-title.data-v-1776d0fe {
  font-size: 17px;
  font-weight: 600;
  color: #1E1E1E;
}
.nav-bar-right.data-v-1776d0fe {
  flex: 0 0 auto;
  padding: 8px;
}

/* 注册表单 */
.register-form.data-v-1776d0fe {
  background-color: #fff;
  border-radius: 16px;
  padding: 24px 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  margin-bottom: 12px;
}

/* 步骤标题 */
.step-title.data-v-1776d0fe {
  font-size: 18px;
  font-weight: 600;
  color: #1E1E1E;
  margin-bottom: 24px;
  text-align: center;
}
.optional-tag.data-v-1776d0fe {
  font-size: 14px;
  color: #007aff;
  font-weight: normal;
  margin-left: 8px;
}

/* 表单样式 */
.form-item.data-v-1776d0fe {
  margin-bottom: 16px;
}
.form-label.data-v-1776d0fe {
  font-size: 14px;
  color: #6C757D;
  margin-bottom: 8px;
  display: block;
}
.form-input-wrapper.data-v-1776d0fe {
  display: flex;
  align-items: center;
  border-radius: 12px;
  padding: 0 12px;
  background-color: #F2F5F9;
  height: 48px;
  transition: all 0.3s ease;
}
.form-input-wrapper.data-v-1776d0fe:focus-within {
  box-shadow: 0 0 0 2px rgba(0,122,255,0.2);
}

/* picker包装器样式 */
.picker-wrapper.data-v-1776d0fe {
  width: 100%;
}

/* 确保picker覆盖整个区域 */
picker.data-v-1776d0fe {
  width: 100%;
}
.form-input.data-v-1776d0fe {
  flex: 1;
  font-size: 15px;
  color: #1E1E1E;
  padding-left: 12px;
  background-color: transparent;
  border: none;
  outline: none;
}
.form-input.data-v-1776d0fe::-webkit-input-placeholder {
  color: #ADB5BD;
}
.form-input.data-v-1776d0fe::placeholder {
  color: #ADB5BD;
}
.form-input.data-v-1776d0fe:disabled {
  color: #1E1E1E;
  opacity: 1;
  -webkit-text-fill-color: #1E1E1E;
}

/* 错误提示 */
.error-text.data-v-1776d0fe {
  font-size: 13px;
  color: #e54d42;
  margin-top: 8px;
  display: block;
}

/* 性别选择器 */
.gender-selector.data-v-1776d0fe {
  display: flex;
  gap: 12px;
}
.gender-item.data-v-1776d0fe {
  flex: 1;
  text-align: center;
  padding: 0 16px;
  background-color: #F2F5F9;
  border-radius: 30px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.gender-item.data-v-1776d0fe:active {
  transform: scale(0.95);
}
.gender-item.active.data-v-1776d0fe {
  background-color: #007aff;
}
.gender-text.data-v-1776d0fe {
  font-size: 14px;
  color: #1E1E1E;
  transition: all 0.3s ease;
}
.gender-item.active .gender-text.data-v-1776d0fe {
  color: #fff;
  font-weight: 600;
}

/* 薪资范围 */
.salary-range.data-v-1776d0fe {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
  background-color: #F2F5F9;
  border-radius: 12px;
  height: 48px;
}
.salary-input.data-v-1776d0fe {
  flex: 1;
  font-size: 15px;
  color: #1E1E1E;
  background: transparent;
  border: none;
  outline: none;
}
.salary-input.data-v-1776d0fe::-webkit-input-placeholder {
  color: #ADB5BD;
}
.salary-input.data-v-1776d0fe::placeholder {
  color: #ADB5BD;
}
.salary-separator.data-v-1776d0fe {
  font-size: 15px;
  color: #6C757D;
}
.salary-unit.data-v-1776d0fe {
  font-size: 13px;
  color: #6C757D;
}

/* 按钮区域 */
.register-buttons.data-v-1776d0fe {
  display: flex;
  gap: 12px;
  margin: 32px 0 16px;
}
.back-btn.data-v-1776d0fe {
  flex: 1;
  height: 48px;
  background-color: #F2F5F9;
  color: #6C757D;
  font-size: 16px;
  border-radius: 30px;
  transition: all 0.3s ease;
  border: none;
}
.back-btn.data-v-1776d0fe:active {
  background-color: #E9ECEF;
  transform: scale(0.98);
}
.register-btn.data-v-1776d0fe {
  flex: 1;
  height: 48px;
  background-color: #007aff;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border-radius: 30px;
  transition: all 0.3s ease;
  border: none;
}
.register-btn.data-v-1776d0fe:active {
  background-color: #0056b3;
  transform: scale(0.98);
}
.register-btn.data-v-1776d0fe:disabled {
  background-color: #E9ECEF;
  color: #ADB5BD;
}

/* 跳过按钮 */
.skip-btn.data-v-1776d0fe {
  flex: 1;
  height: 48px;
  background-color: #F2F5F9;
  color: #6C757D;
  font-size: 16px;
  border-radius: 30px;
  transition: all 0.3s ease;
  border: none;
}
.skip-btn.data-v-1776d0fe:active {
  background-color: #E9ECEF;
  transform: scale(0.98);
}

/* 注册步骤 */
.register-step.data-v-1776d0fe {
  display: none;
  animation: fadeIn-1776d0fe 0.3s ease-in-out;
}
.register-step.active.data-v-1776d0fe {
  display: block;
}
.register-step.optional.data-v-1776d0fe {
  display: block;
  animation: fadeIn-1776d0fe 0.3s ease-in-out;
}

/* 动画效果 */
@keyframes fadeIn-1776d0fe {
from {
    opacity: 0;
    transform: translateY(12px);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
